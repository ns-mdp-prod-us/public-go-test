{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "addLabels": [
    "renovate",
  ],
  "env": {
    "GOPRIVATE": "github.com/ns-pkgs/golang-lib-private",
    "GONOSUMDB": "github.com/ns-pkgs/golang-lib-private",
    "GONOPROXY": "github.com/ns-pkgs/golang-lib-private",
  },
/*
  "hostRules": [
    {
      "matchHost": "https://github.com/ns-pkgs/",
      "token": "{{ secrets.RO__ns_pkgs }}",
      "hostType": "go"
    },
    {
      "matchHost": "https://api.github.com/repos/ns-pkgs/",
      "token": "{{ secrets.RO__ns_pkgs }}",
      "hostType": "github"
    }
  ]
*/
}
