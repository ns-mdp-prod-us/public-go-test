{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "addLabels": [
    "renovate",
    "deps" 
  ],
  "env": {
    "GOPRIVATE": "github.com/ns-pkgs/golang-lib-private",
    "GONOSUMDB": "github.com/ns-pkgs/golang-lib-private",
    "GONOPROXY": "github.com/ns-pkgs/golang-lib-private",
  },
  "hostRules": [
    {
      "matchHost": "github.com/ns-pkgs/golang-lib-private",
      "token": "{{ secrets.RO__ns_pkgs }}"
    },
    {
      "matchHost": "api.github.com/ns-pkgs/golang-lib-private",
      "token": "{{ secrets.RO__ns_pkgs }}"
    }
  ]
}
